# Payload backend origin (REST API at <url>/api, media at <url>/media). Inlined into client bundles at build time.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Public origin of this site, used for canonical URLs, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Optional, server only: API root used for the menu request, e.g. an internal address.
# Defaults to ${NEXT_PUBLIC_SERVER_URL}/api.
# API_URL=http://localhost:3000/api
